# --- Next.js (browser) ---
NEXT_PUBLIC_SERVER_URL=http://localhost:9100

# --- Cesium server (Node) ---
# Loaded from repo root `.env.local` / `.env` when you run `npm run dev` in `server/`,
# or from `server/.env` if you prefer to keep secrets only under server/.
#
# Bind address. Default is 127.0.0.1 — the engine stays on this machine.
# HOST=0.0.0.0 is refused unless OPENCURSOR_AUTH_USERNAME and
# OPENCURSOR_AUTH_PASSWORD are both set. There is no open-network exception.
# HOST=127.0.0.1
#
# Default workspace opened on first bootstrap. Must lie under an allowed root
# (see WORKSPACE_ALLOWED_ROOTS). If unset, the server uses the repo parent of `server/`.
WORKSPACE_ROOT=C:\Users\benpr\OneDrive\Documents\Projects\cesium

# Optional: comma-separated absolute directory paths workspace roots may live under.
# When set, ONLY these paths are allowed (no automatic repo-root fallback).
# WORKSPACE_ALLOWED_ROOTS=C:\Users\benpr\OneDrive\Documents\Projects

# Optional escape hatch (avoid in production):
# OPENCURSOR_ALLOW_ANY_WORKSPACE_ROOT=1

# Optional CLI overrides for additional agent backends:
# OPENCURSOR_CURSOR_CLI_BIN=/absolute/path/to/agent
# OPENCURSOR_CURSOR_ACP_BIN=/absolute/path/to/agent
# Optional argv after the binary (JSON array of strings), e.g. subcommands your build needs:
# OPENCURSOR_CURSOR_AGENT_ARGS=[]
# Shorthand for Cursor agent: pass-through to --permission-mode (see Cursor CLI docs for valid values):
# OPENCURSOR_CURSOR_PERMISSION_MODE=default
# Devin CLI ACP: `curl -fsSL https://cli.devin.ai/install.sh | bash` then `devin acp`, or set an explicit binary:
# OPENCURSOR_DEVIN_CLI_BIN=/absolute/path/to/devin
# Optional JSON argv for ACP (default: ["acp"]).
# OPENCURSOR_DEVIN_CLI_ARGS=["acp"]
# Optional Devin/Windsurf API key when `devin auth login` credentials are unavailable:
# WINDSURF_API_KEY=
# Google Antigravity CLI (successor to Gemini CLI): install `agy`, sign in with Google OAuth on the host, or set:
# OPENCURSOR_ANTIGRAVITY_CLI_BIN=/absolute/path/to/agy
# OPENCURSOR_AGY_BIN=/absolute/path/to/agy
# OPENCURSOR_CODEX_BIN=/absolute/path/to/codex
# OPENCURSOR_CLAUDE_BIN=/absolute/path/to/claude
#
# Optional JSON merged into ACP `initialize.clientCapabilities` (Devin / other ACP backends).
# Example if the CLI rejects tools until terminal delegation is advertised:
# OPENCURSOR_ACP_CLIENT_CAPABILITIES_JSON={"terminal":true}

# Optional speech-to-text provider for composer voice input.
# Uses an OpenAI-compatible multipart transcription endpoint, so this can point at
# OpenAI-style or Groq-compatible hosts.
# OPENCURSOR_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
# OPENCURSOR_TRANSCRIPTION_API_KEY=<secret>
# OPENCURSOR_TRANSCRIPTION_MODEL=<transcription-model-id>
# OPENCURSOR_TRANSCRIPTION_LANGUAGE=en
# OPENCURSOR_TRANSCRIPTION_PROMPT=

# Optional Cesium Agent OpenAI-compatible host bootstrap (chat — not transcription).
# When BASE_URL points at a non-OpenAI host, Cesium registers an env provider with
# default model kimi-k3 (text / tools / images, ~1M context).
# CESIUM_BASE_URL=https://infer.techlitnow.com/v1
# CESIUM_API_KEY=   # falls back to OPENAI_API_KEY
# CESIUM_DEFAULT_MODEL=kimi-k3
# CESIUM_PROVIDER_ID=techlit
# CESIUM_MODELS=kimi-k3

# --- Storage backend (OSP-75) ---
# Choose "legacy-json" (default, zero external deps) or "pg" (Postgres + Redis).
# Launch the backing services locally with `docker compose up -d` from the repo
# root, then run `npm run db:migrate --prefix server` before switching to "pg".
# OPENCURSOR_STORAGE_DRIVER=legacy-json
# DATABASE_URL=postgres://cesium:cesium@localhost:5433/cesium
# REDIS_URL=redis://localhost:6380

# --- Cesium Cloud Context (Convex + Clerk) ---
# Cross-device user context: servers, personalization, agent prefs, onboarding
# progress, and portable conversation snapshots. Three modes:
#   disabled (default): no NEXT_PUBLIC_CONVEX_URL — fully local-first, exactly
#             the pre-cloud behavior (engine password login via
#             OPENCURSOR_AUTH_* remains the only "account").
#   device:   Convex URL only — per-browser device identity; the Convex
#             deployment must set CESIUM_ALLOW_DEVICE_KEYS=1 to accept it
#             (`npx convex env set CESIUM_ALLOW_DEVICE_KEYS 1`).
#   clerk:    Convex + Clerk — production sign-in-anywhere. Requires a Clerk
#             JWT template named "convex" and CLERK_JWT_ISSUER_DOMAIN set on
#             the Convex deployment.
#
# Master switch: NEXT_PUBLIC_CESIUM_CLOUD. Leave unset (or "1") to derive the
# mode from the vars below; set to "0" to force local-only even when the
# Convex/Clerk vars are configured (one-knob toggle between a personal local
# install and a cloud-backed deployment of the same build config).
# NEXT_PUBLIC_CESIUM_CLOUD=0
#
# Resolution order on every platform (web, Electron, Android, iOS):
# env vars above > committed defaults in src/lib/cloud/cloud-defaults.ts.
# Shipped apps default to production cloud behavior once those defaults are
# populated; any user can still flip a device to local-only at runtime from
# Settings -> Account -> Cloud sync (no rebuild needed).
#
# Public production gate (clerk mode only): require sign-in for every route,
# so an internet-facing client is only usable by authenticated Clerk users.
# Optionally pair with NEXT_PUBLIC_CLERK_SIGN_IN_URL for a custom sign-in page.
# NEXT_PUBLIC_CESIUM_REQUIRE_SIGN_IN=1
#
# Local development without any accounts: `npx convex dev` (anonymous local
# deployment) prints the CONVEX_URL to use here.
# NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
#
# Hosted auth pages ship at /sign-in and /sign-up; override only if you host
# them elsewhere (e.g. the Clerk Account Portal).
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Production deployment (Vercel + custom domain) ---
# Canonical site origin for SEO metadata (robots.txt, sitemap.xml, Open Graph).
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
# NEXT_PUBLIC_SITE_URL=https://cesium.techlitnow.com
#
# The /download page proxies the GitHub latest-release catalog through
# /api/releases/latest (cached 10 min). A token raises the upstream API rate
# limit; a public repo works without one.
# GITHUB_RELEASES_TOKEN=ghp_...
#
# Engine discovery (Connect-URL rendezvous) needs a KV store on Vercel:
# either an Upstash Redis integration or Vercel KV. Set one pair:
# UPSTASH_REDIS_REST_URL= / UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL= / KV_REST_API_TOKEN=
