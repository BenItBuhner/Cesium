{
  "name": "cesium-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/runtime/bun-server.ts",
    "dev:node": "cross-env NODE_ENV=development NODE_OPTIONS=--max-old-space-size=3072 tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "bun src/runtime/bun-server.ts",
    "start:node": "cross-env NODE_ENV=production node --max-old-space-size=3072 dist/index.js",
    "test": "node --import tsx --test ./test/*.test.ts",
    "test:mcp": "node --import tsx --test ./test/mcp-prompt.test.ts ./test/mcp-mirror.test.ts ./test/mcp-url-policy.test.ts ./test/mcp-oauth.test.ts ./test/phone-control.test.ts",
    "test:bun:smoke": "bun test ./test/bun-smoke.test.ts",
    "seed:fat-conversations": "bun ./scripts/seed-fat-conversations.ts",
    "seed:perf:small": "bun ./scripts/seed-fat-conversations.ts --conversations=3 --turns=25",
    "seed:perf:medium": "bun ./scripts/seed-fat-conversations.ts --conversations=12 --turns=250",
    "seed:perf:fat": "bun ./scripts/seed-fat-conversations.ts --conversations=30 --turns=3500",
    "perf:run": "tsx ./scripts/perf-runner.ts",
    "perf:browser": "tsx ./scripts/perf-browser.ts",
    "perf:bun": "bun ./scripts/perf-runner.ts",
    "perf:compare": "tsx ./scripts/perf-compare.ts",
    "sdk:cursor-probe": "tsx ./scripts/cursor-sdk-probe.ts",
    "sdk:claude-probe": "bun ./scripts/claude-code-sdk-proxy-probe.ts",
    "sdk:pi-probe": "tsx ./scripts/pi-agent-probe.ts",
    "mcp:probe": "tsx ./scripts/mcp-cesium-minimax-probe.ts",
    "harness:probe-checklist": "tsx ./scripts/harness-probe-checklist.ts",
    "codex:app-server-probe": "bun ./scripts/codex-app-server-probe.ts",
    "bun:native-check": "bun ./scripts/bun-native-check.ts",
    "bun:live-smoke": "bun ./scripts/bun-live-smoke.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "storage:stats": "tsx ./scripts/storage-migrate.ts --stats",
    "storage:migrate": "tsx ./scripts/storage-migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.159",
    "@cesium/contracts": "file:../packages/contracts",
    "@cesium/core": "file:../packages/core",
    "@cursor/sdk": "1.0.28",
    "@earendil-works/pi-coding-agent": "^0.79.0",
    "@hono/mcp": "^0.3.1",
    "@hono/node-server": "^1.19.15",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "chart.js": "^4.5.0",
    "chokidar": "^4.0.3",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.11",
    "ioredis": "^5.10.1",
    "playwright": "^1.56.0",
    "postgres": "^3.4.9",
    "undici": "^7.30.1",
    "ws": "^8.21.0"
  },
  "optionalDependencies": {
    "kokoro-js": "^1.2.1",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/ws": "^8.18.1",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "@babel/core@7": "^7.29.6",
    "@babel/plugin-transform-modules-systemjs@7": "^7.29.4",
    "@fastify/busboy": "^3.2.1",
    "@hono/node-server": "^1.19.15",
    "@humanfs/node": "^0.16.8",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@xmldom/xmldom": "^0.8.15",
    "baseline-browser-mapping": "^2.11.0",
    "body-parser": "^2.4.0",
    "brace-expansion@1": "^1.1.21",
    "brace-expansion@2": "^2.1.7",
    "brace-expansion@5": "^5.0.12",
    "browserslist": "^4.28.7",
    "compression": "^1.8.2",
    "dompurify": "^3.4.0",
    "esbuild": "^0.28.1",
    "fast-uri@3": "^3.1.9",
    "fast-xml-parser": "^5.10.1",
    "form-data": "^4.0.6",
    "hono": "^4.13.11",
    "http-cache-semantics": "^4.3.0",
    "ip-address": "^10.7.4",
    "joi@17": "^17.13.8",
    "js-yaml@3": "^3.15.0",
    "js-yaml@4": "^4.2.0",
    "launch-editor": "^2.14.2",
    "lodash": "^4.18.0",
    "moment": "^2.31.0",
    "nanoid@3": "^3.3.18",
    "picomatch@2": "^2.3.2",
    "picomatch@4": "^4.0.4",
    "postcss": "^8.5.23",
    "protobufjs@7": "^7.6.5",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.0",
    "serialize-javascript": "^7.0.3",
    "sharp": "^0.35.5",
    "shell-quote": "^1.11.0",
    "source-map-js": "^1.2.2",
    "tar": "^7.5.21",
    "tmp": "^0.2.6",
    "undici@5": "^6.29.1",
    "undici@8": "^8.12.2",
    "vite": "^7.3.7",
    "zod@^4": "^4.6.6",
    "@earendil-works/pi-coding-agent": {
      "undici": "^8.12.2",
      "brace-expansion": "^5.0.12",
      "fast-xml-parser": "^5.10.1",
      "protobufjs": "^7.6.5"
    },
    "ws@6": "^6.2.4",
    "ws@7": "^7.5.11",
    "ws@8": "^8.21.0"
  }
}
