# Copy to `server/.env` or set the same keys in the repo root `.env.local`.
# See repo root `.env.example` for full documentation.

WORKSPACE_ROOT=C:\Users\benpr\OneDrive\Documents\Projects\cesium
# WORKSPACE_ALLOWED_ROOTS=C:\Users\benpr\OneDrive\Documents\Projects
PORT=9100
# When `PUBLIC_HOST` is an RFC1918 LAN IP (e.g. 192.168.x.x), credentialed CORS also
# allows other private-LAN `Origin` values (another workstation opening the Next UI).
# Set to `0` to disable and require an explicit match in root `ALLOWED_ORIGINS` only.
# OPENCURSOR_ALLOW_PRIVATE_LAN_ORIGINS=0
# Android's bundled file:// workbench uses the opaque "null" origin. It stays
# allowed when ALLOWED_ORIGINS is customized; set this to 0 to hard-disable it.
# OPENCURSOR_ALLOW_ANDROID_FILE_ORIGIN=0
# OPENCURSOR_CURSOR_CLI_BIN=/absolute/path/to/agent
# OPENCURSOR_CURSOR_ACP_BIN=/absolute/path/to/agent
# OpenCode (current release): Cesium runs `opencode serve` per workspace over its native HTTP/SSE API,
# or connects to a server you already run (`opencode serve --port 4096`). Explicit binary, else PATH /
# ~/.opencode/bin/opencode (see OPENCURSOR_REAL_HOME).
# OPENCURSOR_OPENCODE_SERVER_BIN=/absolute/path/to/opencode
# OPENCURSOR_OPENCODE_SERVER_URL=http://127.0.0.1:4096
# OPENCURSOR_OPENCODE_SERVER_USERNAME=
# OPENCURSOR_OPENCODE_SERVER_PASSWORD=
# OpenCode v2 Beta (`@opencode-ai/cli@beta`): one shared `opencode2 serve --stdio` process for all
# workspaces, or an external authenticated v2 server (`opencode2 serve --port 4097`).
# OPENCURSOR_OPENCODE_V2_SERVER_BIN=/absolute/path/to/opencode2
# OPENCURSOR_OPENCODE_V2_SERVER_URL=http://127.0.0.1:4097
# OPENCURSOR_OPENCODE_V2_PASSWORD=
# OPENCURSOR_OPENCODE_V2_CONFIG_DIR=/absolute/path/to/opencode-v2-config
# Force the dialect for new chats (`current` | `v2-beta`); otherwise the chat's "Generation" option decides.
# OPENCURSOR_OPENCODE_PROTOCOL=
# Managed server startup budget (first start may migrate the database and fetch catalogs). Default 60000.
# OPENCURSOR_OPENCODE_STARTUP_TIMEOUT_MS=60000
# How long a managed server stays warm after its last chat detaches before Cesium stops it (default 10 min;
# 0 stops it immediately). Servers are always stopped when Cesium exits.
# OPENCURSOR_OPENCODE_SERVER_LINGER_MS=600000
# Both OpenCode generations share ~/.local/share/opencode/opencode.db. A database first created by the
# v2 beta cannot be opened by the current release ("Database is not empty and has no session table").
# Give one generation its own file (relative to OpenCode's data dir, or absolute):
# OPENCURSOR_OPENCODE_DB=opencode-current.db
# OPENCURSOR_OPENCODE_V2_DB=opencode-beta.db
# When the server runs with a different $HOME (Docker/systemd), point at the real user home for ~/.opencode lookup.
# OPENCURSOR_REAL_HOME=/home/youruser
# OPENCURSOR_CURSOR_AGENT_ARGS=[]
# OPENCURSOR_CURSOR_PERMISSION_MODE=default
# Devin CLI ACP / Antigravity CLI (see repo root `.env.example`):
# OPENCURSOR_DEVIN_CLI_BIN=/absolute/path/to/devin
# OPENCURSOR_DEVIN_CLI_ARGS=["acp"]
# WINDSURF_API_KEY=
# OPENCURSOR_ANTIGRAVITY_ACP_BIN=/absolute/path/to/agy_acp_server.par
# OPENCURSOR_ANTIGRAVITY_ACP_ARGS=["--uid="]
# OPENCURSOR_ANTIGRAVITY_ACP_HOME=/home/you/.gemini
# GEMINI_API_KEY=
# OPENCURSOR_ANTIGRAVITY_CLI_BIN=/absolute/path/to/agy
# OPENCURSOR_AGY_BIN=/absolute/path/to/agy
# OPENCURSOR_CODEX_BIN=/absolute/path/to/codex
# OPENCURSOR_CLAUDE_BIN=/absolute/path/to/claude
# OPENCURSOR_ACP_CLIENT_CAPABILITIES_JSON={"terminal":true}
# OPENCURSOR_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
# OPENCURSOR_TRANSCRIPTION_API_KEY=<secret>
# OPENCURSOR_TRANSCRIPTION_MODEL=<transcription-model-id>
# Or mount JSON (survives git-only deploy): see server/transcription-provider.json.example
# OPENCURSOR_TRANSCRIPTION_CONFIG_FILE=/run/secrets/transcription-provider.json
# Or one secret string (JSON object) for PaaS/Kubernetes:
# OPENCURSOR_TRANSCRIPTION_CONFIG_JSON={"baseUrl":"https://api.groq.com/openai/v1","apiKey":"…","model":"whisper-large-v3"}
# OPENCURSOR_TRANSCRIPTION_LANGUAGE=en
# OPENCURSOR_TRANSCRIPTION_PROMPT=

# Agent handoff: number of recent message pairs to include when handing off to a different agent (default: 50)
# OPENCURSOR_AGENT_HANDOFF_MESSAGE_LIMIT=50

# -----------------------------------------------------------------------------
# Storage backend (OSP-75)
# -----------------------------------------------------------------------------
# Driver resolution:
#   1. If OPENCURSOR_STORAGE_DRIVER is set, it always wins (opt-in override).
#   2. Else if DATABASE_URL is set, the "pg" driver is used (Phase 6 default).
#   3. Else the legacy JSON/JSONL driver is used so a fresh clone still works
#      with zero external services.
#
# To keep the legacy driver after configuring DATABASE_URL, set this explicitly:
# OPENCURSOR_STORAGE_DRIVER=legacy-json
#
# Postgres connection string. Matches the defaults baked into docker-compose.yml
# at the repo root (`docker compose up -d` + `npm run db:migrate` brings it up).
DATABASE_URL=postgres://cesium:cesium@localhost:5433/cesium
# DATABASE_POOL_MAX=10
# DATABASE_IDLE_TIMEOUT_SEC=20
# DATABASE_CONNECT_TIMEOUT_SEC=10
#
# Redis is optional. When unset, pub/sub, KV cache, and rate limiting fall back
# to in-process implementations (EventEmitter / Map). Configure it for multi-
# process deployments or to share cache between the HTTP server and workers.
# REDIS_URL=redis://localhost:6380
# OPENCURSOR_REDIS_DEBUG=0
#
# First-boot helper:
# When the pg driver is active but a legacy data directory still exists on
# disk, the server prints a one-time banner on boot pointing at the migration
# tool. To migrate manually:
#   npm --prefix server run storage:migrate -- --from legacy-json --to pg
# To inspect both drivers without migrating:
#   npm --prefix server run storage:stats
