{
  "name": "@cesium/core",
  "version": "0.1.0",
  "description": "Shared public domain types and protocol helpers for Cesium",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./platform-surfaces": {
      "types": "./dist/platform-surfaces.d.ts",
      "import": "./dist/platform-surfaces.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./model-display-name": {
      "types": "./dist/model-display-name.d.ts",
      "import": "./dist/model-display-name.js"
    },
    "./phone-control": {
      "types": "./dist/phone-control.d.ts",
      "import": "./dist/phone-control.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/fix-esm-specifiers.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@cesium/config": "file:../config",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
